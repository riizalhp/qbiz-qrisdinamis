# =============================================================================
# QBiz QRIS Dinamis & Gateway Hub - Environment Configuration Template
# =============================================================================

# Server Port (Default: 8000)
PORT=8000

# Base Public URL (Optional - used for OAuth redirects and dynamic QRIS URLs)
# BASE_URL=https://qris.yourdomain.com

# Cryptographic Secrets (Generate with `openssl rand -hex 16` or similar)
COOKIE_SECRET=change_me_to_a_secure_random_cookie_secret_key_2026
JWT_SECRET=change_me_to_a_secure_random_jwt_secret_key_2026

# PostgreSQL Database Configuration (Internal or External)
DB_USER=qbiz_user
DB_PASSWORD=your_secure_database_password_2026
DB_NAME=qrispaymti

# Full Connection String (Overrides individual DB_* params if set)
DATABASE_URL=postgres://qbiz_user:your_secure_database_password_2026@localhost:5432/qrispaymti
# If using Docker Compose, use @db:5432 instead of @localhost:5432:
# DATABASE_URL=postgres://qbiz_user:your_secure_database_password_2026@db:5432/qrispaymti

# Puppeteer Chromium Path (Pre-configured in Docker image at /usr/bin/chromium)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# --- Employr additions ---
# Image yang dijalankan compose (isi dengan digest hasil build CI sendiri)
# QBIZ_IMAGE=ghcr.io/riizalhp/qbiz-qrisdinamis@sha256:REPLACE_WITH_DIGEST

# Akun SUPER_ADMIN pertama. Hanya dipakai bila tabel users masih kosong. Kata sandi minimal 12 karakter.
# Hapus INITIAL_ADMIN_PASSWORD dari env setelah login pertama.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Secret HMAC untuk tanda tangan webhook (tanpa ini webhook tidak dikirim). openssl rand -hex 32
WEBHOOK_SECRET=

# true = izinkan QRIS contoh, jalur OTP tiruan, dan simulasi bayar untuk SEMUA invoice. Jangan true di produksi.
SANDBOX_MODE=false

# true = aktifkan /docs (memuat skrip CDN tanpa versi). Biarkan false di produksi.
ENABLE_API_DOCS=false

# Alamat bind port web di host (bawaan hanya lokal)
# BIND_ADDR=127.0.0.1
